<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    >

    <title>Love For Chelyn</title>

    <!-- FONT -->
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- BACKGROUND -->

    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    <div
        class="particles"
        id="particles"
    ></div>


    <!-- HEADER -->

    <header class="top-header">

        <div class="brand">

            <span class="brand-dot"></span>

            <span class="brand-text">
                LOVE FOR CHELYN
            </span>

        </div>


        <div class="chapter-info">

            <div
                class="chapter-number"
                id="chapterNumber"
            >
                01 / 10
            </div>

            <div
                class="chapter-label"
                id="chapterLabel"
            >
                THE LETTER
            </div>

        </div>

    </header>


    <!-- MUSIC VISUALIZER -->

    <div
        class="music-visualizer"
        id="musicVisualizer"
        aria-hidden="true"
    >
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
    </div>


    <!-- FLOATING LOVE -->

    <div
        class="love-corner"
        id="loveCorner"
        aria-hidden="true"
    >
        <span>♥</span>
        <span>♡</span>
        <span>♥</span>
        <span>♡</span>
        <span>♥</span>
        <span>♡</span>
        <span>♥</span>
        <span>♡</span>
    </div>


    <!-- CHAPTER 1 — LETTER -->

    <section
        class="scene active"
        id="scene1"
    >

        <div class="scene-inner">

            <div class="chapter-kicker reveal">
                A LETTER FOR YOU
            </div>


            <div class="letter-stage reveal">

                <div class="letter-glow"></div>

                <div
                    class="envelope"
                    id="envelope"
                    role="button"
                    tabindex="0"
                    aria-label="Buka surat"
                >

                    <div class="envelope-back"></div>

                    <div class="letter-paper">

                        <div class="letter-small">
                            UNTUK KAMU
                        </div>

                        <div class="letter-line"></div>

                        <div class="letter-name">
                            Chelyn
                        </div>

                        <div class="letter-love">
                            ♥
                        </div>

                    </div>

                    <div class="envelope-front"></div>

                    <div class="envelope-flap"></div>

                    <div class="letter-seal">
                        ♡
                    </div>

                </div>

            </div>


            <h1 class="hero-title reveal">
                Ada sesuatu yang<br>
                ingin Diky ceritakan.
            </h1>


            <p class="hero-description reveal">
                Bukan sesuatu yang harus kamu jawab.<br>
                Cukup baca sampai akhir.
            </p>


            <button
                class="premium-button reveal"
                id="openLetterButton"
                type="button"
            >
                <span>Buka surat</span>
                <span class="button-arrow">→</span>
            </button>

        </div>

    </section>


    <!-- CHAPTER 2 -->

    <section
        class="scene"
        id="scene2"
    >

        <div class="scene-inner">

            <div class="story-card">

                <div class="story-divider reveal"></div>

                <div class="chapter-kicker reveal">
                    CHAPTER TWO
                </div>

                <h2 class="story-title reveal">
                    Semuanya berawal
                    dari hal yang
                    sederhana.
                </h2>

                <div class="story-divider reveal"></div>

                <p class="story-text reveal">
                    Diky nggak pernah benar-benar tahu kapan tepatnya
                    semuanya berubah. Mungkin awalnya cuma obrolan
                    biasa, perhatian kecil, atau sekadar kehadiran yang
                    perlahan terasa berbeda.
                </p>

                <p class="story-text reveal">
                    Tapi ada beberapa orang yang datang tanpa suara
                    besar, lalu entah bagaimana meninggalkan jejak
                    yang jauh lebih dalam daripada yang kita sadari.
                </p>

                <button
                    class="premium-button next-button reveal"
                    data-next="3"
                    type="button"
                >
                    <span>Lanjut</span>
                    <span class="button-arrow">→</span>
                </button>

            </div>

        </div>

    </section>


    <!-- CHAPTER 3 -->

    <section
        class="scene"
        id="scene3"
    >

        <div class="scene-inner">

            <div class="story-card">

                <div class="chapter-kicker reveal">
                    CHAPTER THREE
                </div>

                <div class="memory-icon reveal">
                    ♡
                </div>

                <h2 class="story-title reveal">
                    Tentang Chelyn.
                </h2>

                <p class="story-text reveal">
                    Ada sesuatu dari cara kamu hadir yang terasa
                    berbeda. Nggak perlu terlalu banyak hal besar,
                    karena hal-hal kecil saja sudah cukup untuk
                    membuat seseorang merasa nyaman.
                </p>

                <p class="story-highlight reveal">
                    Dan mungkin itu yang paling Diky suka.
                </p>

                <button
                    class="premium-button next-button reveal"
                    data-next="4"
                    type="button"
                >
                    <span>Lanjut</span>
                    <span class="button-arrow">→</span>
                </button>

            </div>

        </div>

    </section>


    <!-- CHAPTER 4 -->

    <section
        class="scene"
        id="scene4"
    >

        <div class="scene-inner">

            <div class="story-card">

                <div class="chapter-kicker reveal">
                    CHAPTER FOUR
                </div>

                <h2 class="story-title reveal">
                    Hal-hal kecil
                    yang berarti.
                </h2>

                <p class="story-text reveal">
                    Kadang bukan tentang percakapan panjang atau
                    sesuatu yang luar biasa. Bisa saja cuma satu
                    perhatian kecil, satu pesan, atau satu momen
                    sederhana yang tiba-tiba menetap di ingatan.
                </p>

                <p class="story-highlight reveal">
                    Hal kecil, tapi punya arti yang besar.
                </p>

                <button
                    class="premium-button next-button reveal"
                    data-next="5"
                    type="button"
                >
                    <span>Lanjut</span>
                    <span class="button-arrow">→</span>
                </button>

            </div>

        </div>

    </section>


    <!-- CHAPTER 5 -->

    <section
        class="scene"
        id="scene5"
    >

        <div class="scene-inner">

            <div class="story-card">

                <div class="chapter-kicker reveal">
                    CHAPTER FIVE
                </div>

                <div class="playful-word reveal">
                    Kamu.
                </div>

                <h2 class="story-title reveal">
                    Punya sisi yang
                    bikin senyum.
                </h2>

                <p class="story-text reveal">
                    Ada sisi lucu, random, dan mungkin kadang
                    bikin Diky geleng-geleng sendiri.
                    Tapi justru hal-hal seperti itu yang membuat
                    seseorang terasa lebih nyata dan dekat.
                </p>

                <p class="story-highlight reveal">
                    Dan jujur, itu menyenangkan.
                </p>

                <button
                    class="premium-button next-button reveal"
                    data-next="6"
                    type="button"
                >
                    <span>Lanjut</span>
                    <span class="button-arrow">→</span>
                </button>

            </div>

        </div>

    </section>


    <!-- CHAPTER 6 -->

    <section
        class="scene"
        id="scene6"
    >

        <div class="scene-inner">

            <div class="story-card">

                <div class="chapter-kicker reveal">
                    CHAPTER SIX
                </div>

                <h2 class="story-title reveal">
                    Kenapa kamu?
                </h2>

                <p class="story-text reveal">
                    Mungkin nggak ada satu alasan sederhana yang bisa
                    menjelaskan semuanya. Karena perasaan kadang
                    tumbuh dari banyak hal kecil yang terkumpul
                    tanpa kita sadari.
                </p>

                <p class="story-highlight large reveal">
                    Tapi kalau harus memilih satu jawaban...
                    Diky cuma tahu bahwa kamu terasa berbeda.
                </p>

                <button
                    class="premium-button next-button reveal"
                    data-next="7"
                    type="button"
                >
                    <span>Lanjut</span>
                    <span class="button-arrow">→</span>
                </button>

            </div>

        </div>

    </section>


    <!-- CHAPTER 7 — CONFESSION -->

    <section
        class="scene scene-night"
        id="scene7"
    >

        <div class="confession-glow"></div>

        <div class="scene-inner">

            <div class="story-card">

                <div class="chapter-kicker reveal">
                    CHAPTER SEVEN
                </div>

                <h2 class="story-title reveal">
                    Ada yang ingin
                    Diky jujurkan.
                </h2>

                <div class="typing-story">

                    <p
                        class="typing-line"
                        id="typeLine1"
                    ></p>

                    <p
                        class="typing-line"
                        id="typeLine2"
                    ></p>

                    <p
                        class="typing-line typing-important"
                        id="typeLine3"
                    ></p>

                </div>

                <button
                    class="premium-button next-button hidden"
                    id="scene7Button"
                    data-next="8"
                    type="button"
                >
                    <span>Lanjut</span>
                    <span class="button-arrow">→</span>
                </button>

            </div>

        </div>

    </section>


    <!-- CHAPTER 8 -->

    <section
        class="scene"
        id="scene8"
    >

        <div class="scene-inner">

            <div class="story-card">

                <div class="chapter-kicker reveal">
                    CHAPTER EIGHT
                </div>

                <div class="memory-icon reveal">
                    ♡
                </div>

                <h2 class="story-title reveal">
                    Terima kasih.
                </h2>

                <p class="story-text reveal">
                    Terima kasih sudah pernah hadir dan menjadi
                    bagian dari cerita ini. Mungkin kamu nggak
                    sadar seberapa berarti beberapa hal kecil
                    yang pernah kamu lakukan.
                </p>

                <p class="story-highlight reveal">
                    Tapi Diky mengingatnya.
                </p>

                <button
                    class="premium-button next-button reveal"
                    data-next="9"
                    type="button"
                >
                    <span>Lanjut</span>
                    <span class="button-arrow">→</span>
                </button>

            </div>

        </div>

    </section>


    <!-- CHAPTER 9 -->

    <section
        class="scene"
        id="scene9"
    >

        <div class="scene-inner">

            <div class="story-card">

                <div class="chapter-kicker reveal">
                    CHAPTER NINE
                </div>

                <h2 class="story-title reveal">
                    Satu hal terakhir.
                </h2>

                <p class="story-text reveal">
                    Apa pun yang terjadi setelah halaman ini,
                    semoga kamu selalu menemukan alasan untuk
                    tersenyum dan merasa bahwa kamu cukup berarti.
                </p>

                <p class="story-highlight large reveal">
                    Karena kamu memang pantas mendapatkan
                    hal-hal baik.
                </p>

                <button
                    class="premium-button next-button reveal"
                    data-next="10"
                    type="button"
                >
                    <span>Lanjut</span>
                    <span class="button-arrow">→</span>
                </button>

            </div>

        </div>

    </section>


    <!-- CHAPTER 10 — ENDING -->

    <section
        class="scene scene-ending"
        id="scene10"
    >

        <div class="ending-light"></div>

        <div class="scene-inner">

            <div class="ending-card">

                <div class="chapter-kicker reveal">
                    CHAPTER TEN
                </div>

                <div class="ending-symbol reveal">
                    ♥
                </div>

                <h2 class="ending-title reveal">
                    Untuk Chelyn.
                </h2>

                <div class="story-divider reveal"></div>

                <p class="ending-text reveal">
                    Diky nggak tahu apa yang akan terjadi setelah
                    halaman ini selesai.
                </p>

                <p class="ending-text reveal">
                    Tapi setidaknya, ada satu hal yang ingin Diky
                    tinggalkan di sini.
                </p>

                <p class="ending-final reveal">
                    Terima kasih sudah pernah menjadi
                    bagian yang berarti.
                </p>

                <p class="ending-signature reveal">
                    — Diky
                </p>


                <!-- ACTION BUTTONS -->

                <div class="ending-actions reveal">

                    <a
                        class="premium-button reply-button"
                        id="replyButton"
                        href="#"
                    >
                        <span>Balas pesan</span>
                        <span class="button-arrow">♡</span>
                    </a>

                </div>


                <!-- SOCIAL LINKS -->

                <div class="social-area reveal">

                    <div class="social-title">
                        TEMUI DIKY DI SINI
                    </div>


                    <div class="social-links">

                        <!-- WHATSAPP -->

                        <a
                            class="social-link"
                            href="https://wa.me/6288229456210"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="WhatsApp"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    d="M20.52 3.48A11.84 11.84 0 0 0 12.09 0C5.55 0 .22 5.33.22 11.87c0 2.09.55 4.13 1.59 5.93L.12 24l6.34-1.66a11.87 11.87 0 0 0 5.63 1.43h.01c6.54 0 11.87-5.33 11.87-11.87 0-3.17-1.23-6.14-3.45-8.42ZM12.1 21.77h-.01a9.88 9.88 0 0 1-5.04-1.38l-.36-.21-3.76.99 1-3.67-.23-.38a9.88 9.88 0 0 1-1.51-5.25C2.19 6.43 6.63 2 12.09 2a9.87 9.87 0 0 1 7.01 2.91 9.87 9.87 0 0 1 2.9 7.02c0 5.46-4.44 9.9-9.9 9.9Zm5.43-7.41c-.3-.15-1.77-.87-2.05-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.96 1.17-.18.2-.35.23-.65.08-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.25-.24-.59-.49-.51-.68-.52h-.58c-.2 0-.53.08-.81.38-.28.3-1.06 1.04-1.06 2.54s1.09 2.95 1.24 3.15c.15.2 2.14 3.27 5.18 4.58.72.31 1.28.5 1.72.64.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.41.25-.69.25-1.28.18-1.41-.08-.12-.28-.2-.58-.35Z"
                                />
                            </svg>
                        </a>


                        <!-- INSTAGRAM -->

                        <a
                            class="social-link"
                            href="https://www.instagram.com/rsx_xt/"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Instagram"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <rect
                                    x="3"
                                    y="3"
                                    width="18"
                                    height="18"
                                    rx="5"
                                    ry="5"
                                ></rect>

                                <circle
                                    cx="12"
                                    cy="12"
                                    r="4"
                                ></circle>

                                <circle
                                    cx="17.5"
                                    cy="6.5"
                                    r="1"
                                    class="fill"
                                ></circle>
                            </svg>
                        </a>


                        <!-- YOUTUBE -->

                        <a
                            class="social-link"
                            href="https://youtube.com/@oficial_tzy"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="YouTube"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    d="M23.5 6.19a3 3 0 0 0-2.11-2.12C19.53 3.56 12 3.56 12 3.56s-7.53 0-9.39.51A3 3 0 0 0 .5 6.19 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.81 3 3 0 0 0 2.11 2.12c1.86.51 9.39.51 9.39.51s7.53 0 9.39-.51a3 3 0 0 0 2.11-2.12A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.81ZM9.55 15.56V8.44L15.82 12l-6.27 3.56Z"
                                />
                            </svg>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- PROGRESS -->

    <div
        class="story-progress"
        aria-hidden="true"
    >
        <span id="progressFill"></span>
    </div>


    <!-- AUDIO -->

    <audio
        id="bgm"
        preload="auto"
        loop
    >
        <source
            src="asset/music.mp3"
            type="audio/mpeg"
        >
    </audio>


    <!-- SCRIPT -->

    <script src="script.js"></script>

</body>

</html>